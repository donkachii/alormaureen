# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact form messages
CONTACT_TO_EMAIL=

# Sender address on a domain verified in Resend, for example "Portfolio <hello@your-domain.com>"
CONTACT_FROM_EMAIL=

# Public site URL with no trailing slash, used for metadata, the sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry DSN, used in the browser and on the server. Sentry stays off when this is empty
NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token for uploading source maps at build time. Keep it secret
SENTRY_AUTH_TOKEN=
